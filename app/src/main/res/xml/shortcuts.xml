<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher shortcuts (long press on the icon): the extras are read by LaunchRequest -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutLongLabel="@string/shortcut_search_long"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="it.emanuelemelini.mitayo.MainActivity"
            android:targetPackage="it.emanuelemelini.mitayo">
            <extra
                android:name="launch_action"
                android:value="search" />
        </intent>
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_season"
        android:shortcutId="season"
        android:shortcutLongLabel="@string/shortcut_season_long"
        android:shortcutShortLabel="@string/shortcut_season">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="it.emanuelemelini.mitayo.MainActivity"
            android:targetPackage="it.emanuelemelini.mitayo">
            <extra
                android:name="launch_action"
                android:value="deck" />
            <extra
                android:name="launch_payload"
                android:value="season" />
        </intent>
    </shortcut>
</shortcuts>
